<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Cafe101.Web.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - My ASP.NET Application</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:BundleReference runat="server" Path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <style>
        /* Hide public navbar on staff and manager pages */
        body.staff-page #mainNavbar {
            display: none !important;
        }

        /* Remove public website spacing */
        body.staff-page .body-content {
            width: 100% !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
        }

            /* Hide public footer */
            body.staff-page .body-content > footer,
            body.staff-page .body-content > hr {
                display: none !important;
            }
    </style>

</head>
<body class='<%= (Request.AppRelativeCurrentExecutionFilePath.StartsWith("~/Manager", System.StringComparison.OrdinalIgnoreCase) ||
                  Request.AppRelativeCurrentExecutionFilePath.StartsWith("~/Staff", System.StringComparison.OrdinalIgnoreCase))
                  ? "staff-page" : "" %>'>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>
        <!-- Navigation bar code, reused on all public pages -->
        <nav id="mainNavbar" class="navbar navbar-expand-lg navbar-dark shadow-sm sticky-top" style="background-color: var(--brand-navy);">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" runat="server" href="~/Default.aspx">
                    <img src="~/Content/images/cafe101 Logo.jpeg" runat="server" alt="Cafe101 Logo" height="60" class="me-2" />
                    <span class="fw-bold text-white">Cafe101</span>
                </a>

                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#mainNav" title="Toggle navigation" aria-controls="mainNav"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-4">
                        <li class="nav-item"><a class="nav-link px-2 text-white fw-bold" runat="server" href="~/Default.aspx">Home</a></li>
                        <li class="nav-item"><a class="nav-link px-2 text-white fw-bold" runat="server" href="~/Default.aspx#about">About Us</a></li>
                        <li class="nav-item"><a class="nav-link px-2 text-white fw-bold" runat="server" href="~/Contact.aspx">Contact</a></li>
                        <li class="nav-item"><a class="btn btn-outline-light btn-sm fw-bold" runat="server" href="~/SignUp.aspx">Sign Up</a></li>
                        <li class="nav-item"><a class="btn btn-nav-signin btn-sm fw-bold ms-lg-2" runat="server" href="~/SignIn.aspx">Sign In</a></li>
                    </ul>
                </div>
            </div>
        </nav>
        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
            <hr />
            <!-- Footer code, show all the relevant details of the company -->
            <footer class="py-4 mt-4 text-white full-bleed" style="background-color: var(--brand-navy); margin-top: 0;">
                <div class="container">
                    <div class="row">
                        <div class="col-md-4">
                            <p class="mb-1 fw-bold">Cafe101</p>
                            <p class="mb-1">Varsity Drive, Westville, Durban, KwaZulu-Natal</p>
                            <p class="mb-1">Phone: 081 332 2130</p>
                            <p class="mb-0">Email: info@cafe101.co.za</p>
                        </div>

                        <div class="col-md-4">
                            <p class="mb-1 fw-bold">Operating Hours (For In-Person Visits)</p>
                            <ul class="list-unstyled mb-0">
                                <li>Monday to Friday: 10:00 AM – 6:00 PM</li>
                                <li>Saturday: 10:00 AM – 2:00 PM</li>
                                <li>Sunday: Closed</li>
                            </ul>
                        </div>

                        <div class="col-md-4 text-md-end">
                            <p class="mb-0">&copy; <%: DateTime.Now.Year %> Cafe101. All rights reserved.</p>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </form>
    <style>
  #chatBtn {
    position: fixed; bottom: 20px; right: 20px; z-index: 1000;
    width: 56px; height: 56px; border-radius: 50%; border: none;
    background: #0d6efd; color: #fff; font-size: 24px; cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,.3);
  }
  #chatPanel {
    position: fixed; bottom: 90px; right: 20px; z-index: 1000;
    width: 320px; height: 420px; display: none; flex-direction: column;
    background: #fff; border: 1px solid #ccc; border-radius: 8px;
    box-shadow: 0 4px 12px rgba(0,0,0,.2); font-family: Arial, sans-serif; font-size: 14px;
  }
  #chatPanel.open { display: flex; }
  #chatHeader { background: #0d6efd; color: #fff; padding: 10px; border-radius: 8px 8px 0 0; }
  #chatLog { flex: 1; overflow-y: auto; padding: 10px; }
  .msg { margin: 6px 0; padding: 6px 10px; border-radius: 10px; max-width: 85%; white-space: pre-wrap; }
  .msg-user { background: #e7f1ff; margin-left: auto; text-align: right; }
  .msg-bot  { background: #f1f1f1; }
  #chatChips { padding: 0 10px 6px; display: flex; flex-wrap: wrap; gap: 4px; }
  .chip { border: 1px solid #0d6efd; color: #0d6efd; background: #fff;
          border-radius: 12px; padding: 3px 8px; font-size: 12px; cursor: pointer; }
  #chatInput { border: none; border-top: 1px solid #ccc; padding: 10px; outline: none; }
</style>

<button type="button" id="chatBtn" title="Chat with us">💬</button>

<div id="chatPanel">
  <div id="chatHeader">FAQ Assistant</div>
  <div id="chatLog"></div>
  <div id="chatChips"></div>
  <input type="text" id="chatInput" placeholder="Ask a question..." maxlength="300" />
</div>

<script>
(function () {
  var url   = '<%= ResolveUrl("~/ChatHandler.ashx") %>';
  var btn   = document.getElementById('chatBtn');
  var panel = document.getElementById('chatPanel');
  var log   = document.getElementById('chatLog');
  var chips = document.getElementById('chatChips');
  var input = document.getElementById('chatInput');
  var loaded = false;

  btn.addEventListener('click', function () {
    panel.classList.toggle('open');
    if (panel.classList.contains('open') && !loaded) {
      loaded = true;
      addMsg('bot', 'Hi! Pick a question below or type your own.');
      loadChips();
    }
    if (panel.classList.contains('open')) input.focus();
  });

  input.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter' || !input.value.trim()) return;
    var text = input.value.trim();
    input.value = '';
    addMsg('user', text);
    send({ message: text });
  });

    function loadChips() {
        var questions = [
            'What are your opening hours?',
            'How long does an order take?',
            'What are the popular items?',
            'How do I add an employee?',
            'How do I add a menu item?',
            'What does low stock mean?'
        ];
        questions.forEach(function (q) {
            var b = document.createElement('button');
            b.type = 'button'; b.className = 'chip'; b.textContent = q;
            b.addEventListener('click', function () {
                addMsg('user', q);
                send({ message: q });
            });
            chips.appendChild(b);
        });
    }

  function send(payload) {
    fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    })
    .then(function (r) { return r.json(); })
    .then(function (d) { addMsg('bot', d.reply); })
    .catch(function () { addMsg('bot', 'Sorry, something went wrong. Please try again.'); });
  }

  function addMsg(who, text) {
    var d = document.createElement('div');
    d.className = 'msg msg-' + who;
    d.textContent = text;            // textContent prevents script injection
    log.appendChild(d);
    log.scrollTop = log.scrollHeight;
  }
})();
</script>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
</body>
</html>
